    [ "r1:2", "esp:GND.2", "black", [] ],

    [ "esp:D33", "ledFlow:A", "green", [] ],
    [ "ledFlow:C", "r2:1", "black", [] ],
    [ "r2:2", "esp:GND.2", "black", [] ],

    [ "esp:D32", "esp:D27", "orange", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:SDA", "esp:D21", "yellow", [] ],
    [ "oled1:SCL", "esp:D22", "purple", [] ]

    { "type": "wokwi-pushbutton", "id": "btn1", "top": 140, "left": -250, "attrs": { "color": "green", "key": " " } },
    { "type": "wokwi-led", "id": "ledValve", "top": 60, "left": -330, "attrs": { "color": "red", "label": "VALVE" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 110, "left": -380, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "ledFlow", "top": 60, "left": -420, "attrs": { "color": "green", "label": "FLOW" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 110, "left": -470, "rotate": 90, "attrs": { "value": "220" } },
